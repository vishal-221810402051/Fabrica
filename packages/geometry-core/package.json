{
  "name": "geometry-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm --filter microfluidic-components build && corepack pnpm --filter project-model build && vitest run src"
  },
  "dependencies": {
    "microfluidic-components": "workspace:*",
    "project-model": "workspace:*"
  }
}
